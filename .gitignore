# Локальное окружение и служебные файлы.
.venv/
venv/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*

# Сохранённые входы и результаты уже отслеживаются Git.
# Новые наборы/эксперименты добавляются явно, чтобы не публиковать их случайно.
/data/
/output/

# Lock-файл нужен для переноса окружения; он может быть глобально исключён.
!uv.lock
